{
  "manifest_version": 3,
  "name": "Link Dashboard",
  "version": "1.4.0",
  "description": "A customizable new-tab dashboard for your web link shortcuts — icons, colors, and sizes your way.",
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "permissions": ["storage", "unlimitedStorage", "bookmarks", "alarms"],
  "host_permissions": [
    "https://api.iconify.design/*",
    "https://api.openverse.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Link Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
